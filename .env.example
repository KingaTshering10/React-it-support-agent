# Copy to .env at the repository root. Use your Azure deployment name.
AZURE_OAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OAI_KEY=replace-with-your-key
AZURE_OAI_DEPLOYMENT=your-chat-deployment-name
AZURE_OAI_API_VERSION=2024-10-21

# Deterministic by default. Use random or always to simulate monitoring timeouts.
MOCK_FAILURE_MODE=off

# Leave unset for an interactive y/N approval prompt.
# Mock-only automation: HITL_AUTO_DECISION=approve or HITL_AUTO_DECISION=deny
